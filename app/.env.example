# Base URL for the backend API.
# Relative URL (/api/v1) routes through Vite dev server proxy to http://127.0.0.1:8000
VITE_API_URL=/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Request timeout in ms
VITE_API_TIMEOUT_MS=15000

# Authentication token key (used in localStorage)
VITE_AUTH_TOKEN_KEY=evenmore_auth_token

# App branding
VITE_APP_NAME=Evenmore ERP
